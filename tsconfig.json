{
	"extends": "$app/tsconfig",
	// TypeScript REPLACES include/exclude, never merges them. This is the set Kit 2
	// generated for the workspace: the children come in through src/routes'
	// re-exports. A list that misses them lets `npm run check` pass on 0 files.
	"include": ["src", "tests", "vite.config.ts"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "es2020",
		"noEmit": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		// The one alias table; vite.config.ts reads it (src/lib/vite/kitAlias.ts). The `../` lives here, never in an
		// import: noEscapePlugin rejects a raw climb. Each tier points $parent at ITSELF, so a child's `$parent/…`
		// lands in whichever tier is serving. The shared tree: keep in sync with ReTreever's, which says ../rapper/.
		"paths": {
			"$parent/siblings": ["../"],
			"$parent/siblings/*": ["../*"],
			"$parent": ["."],
			"$parent/*": ["./*"],
			"$rig": ["./rig"],
			"$rig/*": ["./rig/*"],
			"$gc": ["./gc"],
			"$gc/*": ["./gc/*"],
			"$rt": ["./rt"],
			"$rt/*": ["./rt/*"]
		}
	}
}
