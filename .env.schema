# Every env var this repo reads; names and bitwarden("<uuid>") pointers only.
# rapper is copied into every public child: no infrastructure host as a literal here.
# WARNING: varlock reads decorators inside comments — no at-sign before a word in prose.
# @defaultSensitive=false @defaultRequired=false
# @auditIgnorePaths(".svelte-kit", "build", "node_modules")
# @import("~/.config/varlock/.env.retreever-local", allowMissing=true)
# @plugin(../node_modules/@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
# ---

# @sensitive @internal @required
BWS_ACCESS_TOKEN=

# --- Mapbox ------------------------------------------------------------------
# Public pk.* token, ships in the bundle; restrict by URL in the Mapbox
# dashboard. Read by getCache_OnlineMap and ReTreever_where, served from here.
# @required @auditIgnore @type=string(startsWith=pk.)
VITE_MAPBOX_TOKEN=bitwarden("a0c35de0-afbc-40ea-9244-b4ab00fdf6df")

# --- Offline map tiles ---------------------------------------------------------
# Read by getCache_OfflineMap, served from here. Unset, the map sends no /pack
# request and only the satellite layer draws. Public read-only hosts, but
# infrastructure a fork must not inherit — so Bitwarden, never a literal here.
# @auditIgnore @type=url
VITE_GC_tiles_prod_worker=bitwarden("7ab0a573-fa10-474f-82bf-b4d20171569f")
# @auditIgnore @type=url
VITE_GC_tiles_dev_worker=bitwarden("c4ec289e-405b-4719-b7eb-b4d201719911")

# --- Build knobs — set on the command line, never in .env ---------------------
# Vite's own build-mode flag (import.meta.env.DEV); the environment never
# sets it. Declared so audit can match the reads.
# @type=string
DEV=
# @type=string
BUILD_TARGET=

# --- Tier facts — pasted in by vite.config.ts `define`, never read from the
# environment. Declared only so audit can match the import.meta.env reads.
# @type=string
VITE_RAPPER_TIER=
# @type=string
VITE_OTHER_TIER=
# @type=url
VITE_OTHER_ORIGIN=
# @type=string
VITE_OTHER_HOME=
# @type=string
VITE_TIER_ROUTES=
# @type=string
VITE_TIER_SLOT=
