{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "en",
	"locales": [
		"en",
		"fr-CA"
	],
	"modules": [
		"https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4/dist/index.js"
	],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./gc/messages/{locale}.json",
			"../getCache_OnlineMap/messages/{locale}.json",
			"../getCache_OfflineMap/messages/{locale}.json"
		]
	}
}
